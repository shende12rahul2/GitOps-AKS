{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "user-service values",
  "type": "object",
  "required": [
    "image",
    "service",
    "resources",
    "serviceAccount",
    "keyVault",
    "sharedStorage"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "tag": {
          "type": "string"
        },
        "allowTagOnly": {
          "type": "boolean"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "port"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP"
          ],
          "description": "Services are internal only; exposure is through the central Ingress."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "logLevel": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authMode": {
          "enum": [
            "entra",
            "password"
          ]
        },
        "sslmode": {
          "enum": [
            "require",
            "verify-full",
            "verify-ca",
            "prefer",
            "disable"
          ]
        },
        "poolSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxOverflow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authMode": {
          "enum": [
            "entra",
            "password",
            "none"
          ]
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "keyVault": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "objectName"
            ]
          }
        }
      }
    },
    "sharedStorage": {
      "type": "object",
      "required": [
        "enabled",
        "mountPath"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "memory"
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "const": false
        },
        "privileged": {
          "const": false
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "const": true
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowFromServices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
